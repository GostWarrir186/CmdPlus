    "CmdPlus" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CmdPlus"
          }
        }
      }
    },
    "CmdPlus needs the Accessibility permission to change scrolling and to react to mouse buttons. Nothing is recorded or sent anywhere." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CmdPlus нужно разрешение «Универсальный доступ», чтобы менять прокрутку и реагировать на кнопки мыши. Ничего не записывается и никуда не отправляется."
          }
        }
      }
    },
    "CmdPlus needs the Accessibility permission to press ⌘V for you." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CmdPlus нужно разрешение «Универсальный доступ», чтобы нажимать ⌘V за вас."
          }
        }
      }
    },
    "CmdPlus needs to restart to change the language." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сменить язык, CmdPlus нужно перезапустить."
          }
        }
      }
    },
    "CmdPlus starts silently: only the menu bar icon appears, no windows." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CmdPlus запускается незаметно: появляется только значок в строке меню, без окон."
